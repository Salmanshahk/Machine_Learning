df_clean = df.copy()
#print(df_clean)
df_clean['Car_age'] = 2026-df_clean['Year']
df_clean.drop(columns=['Year'],inplace=True)
print(df_clean)

# Encode Categoricals

cat_cols = df_clean.select_dtypes(include=['object']).columns.to_list()
print(cat_cols)

label_mappings = {}
le=LabelEncoder()

for col in cat_cols:
    df_clean[col] = le.fit_transform(df_clean[col])
    label_mappings[col] = dict(zip(le.classes_,le.transform(le.classes_)))

print(" Label Encoding")

for col,mapping in label_mappings.items():
    print(f" {col} : {mapping} ")

# 4. Correlation Heatmap

plt.figure(figsize=(14,10))
sns.heatmap(df_clean.corr(),annot = True,cmap = 'coolwarm',fmt = '.2f',linewidth=0.5)
plt.title("Feature Correlation Matrix",fontsize = 20)
plt.tight_layout()
plt.savefig("Correlation_heat.png",dpi = 200)
plt.close()

X = df_clean.drop(columns=[TARGET_COL])
Y = df_clean[TARGET_COL]

print(f"\n feature columns: {list(X.columns)}")
print(f"Target columns: {TARGET_COL}")


X_train,X_test,Y_train,Y_test = train_test_split(X,Y,test_size=0.3,random_state=42)

print(f"\n Training Samples: {len(X_train)}")
print(f"\n Testing Samples: {len(X_test)}")

# Baseline Decision Tree

baseline = DecisionTreeRegressor(random_state=42)
baseline.fit(X_train,Y_train)
y_pred_base = baseline.predict(X_test)

print(f"Baseline r2 : {r2_score(Y_test,y_pred_base)}")
print(f"Baseline MAE: ${mean_absolute_error(Y_test,y_pred_base)}")

# HYPERPARAMETER TUNING - GRIDSearchCV
param_grid = {
    'criterion':['squared_error','friedman_mse','absolute_error'],
    'splitter':['best','random'],
    'max_depth':[2,4,5,8,10,15,20,None],
    'min_samples_split':[2,5,10],
    'max_features':['sqrt','log2',None],
}

grid_search = GridSearchCV(
    DecisionTreeRegressor(random_state=42),
    param_grid=param_grid,
    scoring='neg_mean_squared_error',
    cv=5,
    verbose=0,
    n_jobs=-1
)

grid_search.fit(X_train,Y_train)
print("\n Best HyperParameter Found: ")
for k,v in grid_search.best_params_.items():
    print(f" {k:22s} : {v} ")

y_pred = grid_search.predict(X_test)

r2 = r2_score(Y_test,y_pred)
mae = mean_absolute_error(Y_test,y_pred)
mse = mean_squared_error(Y_test,y_pred)
rmse = np.sqrt(mse)

print("_"*45)
print("Tuned Model Evaluation")

print(f"R2 Score : {r2:.4f}")
print(f"MAE: $ {mae:.2f}")
print(f"MSE : $ {mse:.2f}")
print(f"RMSE : $ {rmse:.2f}")

# Evaluation Plots

fig,axes = plt.subplots(nrows=1,ncols=3,figsize=(21,6))
